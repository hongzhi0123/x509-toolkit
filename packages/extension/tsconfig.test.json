{
  "compilerOptions": {
    "outDir": "./out/test",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["mocha", "node", "vscode"]
  },
  "include": ["src/test/**/*.ts"]
}
