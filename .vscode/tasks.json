{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:extension",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/c", "npm.cmd", "run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/packages/extension"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$webpack-watch"]
    }
  ]
}
